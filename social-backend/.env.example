# Copy to .env and adjust for your environment. All values below are the dev defaults
# already baked into app/config.py, so running with no .env at all keeps working exactly
# like today.

# JWT signing secret for this service. MUST differ from registry-backend's SECRET_KEY,
# and MUST be changed to a long random value before any real deployment.
SECRET_KEY=dev-social-secret-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./social.db

# Base URL of registry-backend's API, used to verify uploads against registered copyrights.
REGISTRY_URL=http://127.0.0.1:8000/api

# How long to wait for the registry's copyright check before giving up (seconds).
# Verification scans the whole registry; typical checks finish in about a second.
REGISTRY_TIMEOUT_SECONDS=45

# Shared secret sent to registry-backend's /api/verify-watermark.
# Must match registry-backend's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key-change-me

# Comma-separated list of origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp,.mp4,.mov,.webm,.avi,.mkv

RATE_LIMIT_UPLOAD=20/minute
