# VibeSocial Frontend Configuration
# Copy this to .env.local and adjust as needed

# API base URL (default: http://127.0.0.1:8001)
VITE_API_URL=http://127.0.0.1:8001

# Copyright registry API, used by the Registry tab on your profile
# (default: http://127.0.0.1:8000)
VITE_REGISTRY_URL=http://127.0.0.1:8000
