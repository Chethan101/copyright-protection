# Copy to .env and adjust for your environment. All values below are the dev defaults
# already baked into app/config.py, so running with no .env at all keeps working exactly
# like today.

# JWT signing secret for this service. MUST differ from social-backend's SECRET_KEY,
# and MUST be changed to a long random value before any real deployment.
SECRET_KEY=dev-registry-secret-change-me

ACCESS_TOKEN_EXPIRE_MINUTES=43200

# SQLAlchemy database URL.
DATABASE_URL=sqlite:///./registry.db

# Local Ganache (or other Ethereum JSON-RPC) endpoint used for best-effort notarization.
GANACHE_RPC_URL=http://127.0.0.1:7545

# Shared secret social-backend must send to call /api/verify-watermark.
# Must match social-backend's INTERNAL_API_KEY.
INTERNAL_API_KEY=dev-internal-key-change-me

# Comma-separated list of origins allowed to call this API.
# 3000 = standalone registry app, 4000 = VibeSocial (embeds the registry in its profile tab).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000

MAX_UPLOAD_SIZE_BYTES=52428800
ALLOWED_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.webp,.mp4,.mov,.webm,.avi,.mkv

DOWNLOAD_TOKEN_EXPIRE_SECONDS=120

RATE_LIMIT_VERIFY=20/minute
RATE_LIMIT_REGISTER=20/minute
